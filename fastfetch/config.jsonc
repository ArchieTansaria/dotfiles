{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "/Users/{YOUR_USERNAME}/.config/fastfetch/logo.png",
    "width": 40,
    "height": 19,
    "padding": {
      "left": 12,
      "right": 12
    }
  },

  "display": {
    "separator": " → ",
    "color": "blue"
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },

    "break",
    "separator",

    {
      "type": "os",
      "key": "OS"
    },

    {
      "type": "host",
      "key": "Host"
    },

    {
      "type": "kernel",
      "key": "Kernel"
    },

    {
      "type": "uptime",
      "key": "Uptime"
    },

    {
      "type": "packages",
      "key": "Packages"
    },

    {
      "type": "shell",
      "key": "Shell"
    },

    {
      "type": "display",
      "key": "Displays"
    },

    {
      "type": "wm",
      "key": "WM"
    },

    {
      "type": "font",
      "key": "Font"
    },

    {
      "type": "terminal",
      "key": "Terminal"
    },

    {
      "type": "cpu",
      "key": "CPU"
    },

    {
      "type": "gpu",
      "key": "GPU"
    },

    {
      "type": "memory",
      "key": "Memory"
    },

    {
      "type": "swap",
      "key": "Swap"
    },

    {
      "type": "disk",
      "key": "Disk"
    },

    {
      "type": "localip",
      "key": "IP"
    },

    {
      "type": "battery",
      "key": "Battery"
    },

    {
      "type": "poweradapter",
      "key": "Power Adapter"
    },

    "break"
  ]
}
